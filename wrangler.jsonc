{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahjong",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "directory": "./dist-app/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "APP", "class_name": "AppDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppDO"] }
  ],
  "r2_buckets": [
    { "binding": "SCANS", "bucket_name": "mahjong-scans" }
  ],
  "observability": {
    "traces": { "enabled": true }
  }
}
